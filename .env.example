# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/?retryWrites=true&w=majority

# Retrain interval in seconds (default: 3600 = 1 hour)
RETRAIN_INTERVAL=3600

# Sliding window size (max records for retraining, default: 3000)
SLIDING_WINDOW_SIZE=3000

# API Configuration
PORT=8000
HOST=0.0.0.0
